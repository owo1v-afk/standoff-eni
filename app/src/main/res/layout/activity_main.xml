<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FF121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENI CHEAT"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FF3DE03D"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Standoff 2"
        android:textColor="#88FFFFFF"
        android:paddingBottom="16dp"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_aimbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aimbot"
        android:textColor="#FFFFFF"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_trigger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trigger Bot"
        android:textColor="#FFFFFF"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_esp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ESP (Skeleton + Boxes)"
        android:textColor="#FFFFFF"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_chams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chams"
        android:textColor="#FFFFFF"/>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/sw_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FOV Circle"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/tv_speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aim speed: 0.6"
        android:textColor="#FFFFFF"
        android:paddingTop="12dp"/>

    <SeekBar
        android:id="@+id/sb_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START"
        android:textSize="16sp"/>

</LinearLayout>
